{
  "info": {
    "name": "SalaryTrack — Register then Login",
    "description": "1) Register (signup) first. 2) Login with the same email and password. Identity uses email for signup; login accepts email or username.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "identityBaseUrl", "value": "http://localhost:9091" },
    { "key": "bffBaseUrl", "value": "http://localhost:8086" }
  ],
  "item": [
    {
      "name": "1 — Register / Signup (identity-service)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"your-password\"\n}"
        },
        "url": "{{identityBaseUrl}}/api/v1/auth/signup",
        "description": "201/200: { \"userId\": \"...\" }. 409: email already registered. Then run Login with the same email and password."
      }
    },
    {
      "name": "1b — Register (BFF — same as signup)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"your-password\"\n}"
        },
        "url": "{{bffBaseUrl}}/api/v1/auth/signup",
        "description": "Proxies to identity. Alternative path: POST {{bffBaseUrl}}/api/v1/auth/register (same body)."
      }
    },
    {
      "name": "2 — Login (identity-service)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"you@example.com\",\n  \"password\": \"your-password\"\n}"
        },
        "url": "{{identityBaseUrl}}/api/v1/auth/login",
        "description": "Use same email as signup. Body can use \"email\" instead of \"username\". Response: { \"token\", \"userId\" } — use token as Bearer for votes."
      }
    },
    {
      "name": "2b — Login (BFF legacy — /api/login)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"your-password\"\n}"
        },
        "url": "{{bffBaseUrl}}/api/login",
        "description": "Only if BffController points to identity; body uses email + password."
      }
    }
  ]
}
